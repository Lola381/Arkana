# Arkana — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   cp .env.example .env
#   # Then edit .env and fill in your own values.
#
# WARNING: Never commit .env to git. It is excluded by .gitignore.
# This file (.env.example) contains ONLY placeholder values and is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arkana
POSTGRES_USER=arkana
POSTGRES_PASSWORD=arkana_secret

# ── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Qdrant (Vector Store) ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333


GROQ_API_KEY=your_key


# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO


DATABASE_URL=postgresql://arkana:arkana_secret@localhost:5432/arkana