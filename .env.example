# ARKANA — Environment Variables Template
#
# ──────────────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE
# ──────────────────────────────────────────────────────────────────────────────
#
# 1. Copy this file:
#       cp .env.example backend/.env
#
# 2. Fill in ALL values marked with <...>
#
# 3. NEVER commit backend/.env to version control.
#    It is already in .gitignore — keep it that way.
#
# 4. Generate strong JWT secrets with:
#       node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    Run this command TWICE — once for each secret below.
#
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ─────────────────────────────────────────────────────────────────────
# The port Express will listen on.
PORT=5000


# ── MongoDB ────────────────────────────────────────────────────────────────────
# Your full MongoDB Atlas connection string.
# Get it from: Atlas Dashboard → Your Cluster → Connect → Drivers → Node.js
# Replace <username>, <password>, and <cluster-name> with your actual values.
#
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>

# The name of the MongoDB database to use.
DATABASE_NAME=arkana


# ── JWT Access Token ────────────────────────────────────────────────────────────
# Used to sign short-lived access tokens (sent as httpOnly cookie and in response body).
# MUST be a cryptographically random string — minimum 64 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
ACCESS_TOKEN_SECRET=<replace-with-64-byte-random-hex>

# How long access tokens are valid.
# Format: https://github.com/vercel/ms#examples
ACCESS_TOKEN_EXPIRY=1d


# ── JWT Refresh Token ───────────────────────────────────────────────────────────
# Used to sign long-lived refresh tokens (stored in MongoDB, sent as httpOnly cookie).
# MUST be different from ACCESS_TOKEN_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
REFRESH_TOKEN_SECRET=<replace-with-different-64-byte-random-hex>

# How long refresh tokens are valid.
REFRESH_TOKEN_EXPIRY=7d


# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: include both Vite's default ports.
# Production: replace with your deployed frontend URL only.
#
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
